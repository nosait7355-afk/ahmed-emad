# ---- Database ----
MONGODB_URI="mongodb://127.0.0.1:27017/trainygo"
MONGODB_DB="trainygo"

# ---- Auth (NextAuth / Auth.js) ----
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ---- Cloudinary (media uploads) ----
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# ---- Seed (first Super Admin) ----
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="fit#x#net2026#"

# ---- Platform ----
# Canonical public origin, no trailing slash. Every absolute URL we generate
# (WhatsApp login links, Open Graph metadata) is built from this — see
# src/lib/app-url.ts. Production must set this to the live domain (currently https://ahmed-emad-one.vercel.app).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_WHATSAPP="201028676395"

# AI nutrition generator (free key: https://aistudio.google.com/apikey). Leave empty to hide the AI button.
GEMINI_API_KEY=
# Optional model override
GEMINI_MODEL=gemini-flash-latest
